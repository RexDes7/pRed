# ──────────────────────────────────────────────────────────────
# ТренерБот — пример переменных окружения
# Скопируйте этот файл в `.env` и заполните своими значениями.
# На Vercel задавайте эти переменные в Settings → Environment Variables.
# ──────────────────────────────────────────────────────────────

# Токен Telegram-бота от @BotFather (https://t.me/BotFather).
# Создайте бота командой /newbot и скопируйте полученный токен.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceWithYourOwn

# Публичный URL приложения (после деплоя на Vercel).
# Используется для подстановки абсолютных URL фотографий товаров в Telegram.
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Числовой ID чата администратора (вашего личного Telegram-аккаунта).
# Получите у @userinfobot или @getmyid_bot.
# Сюда будут пересылаться уведомления о новых заказах.
# Оставьте пустым, чтобы отключить уведомления.
ADMIN_CHAT_ID=

# URL подключения к базе данных.
#
# Локальная разработка (SQLite — файл создаётся автоматически):
DATABASE_URL=file:./db/custom.db
#
# Production на Vercel (нужна PostgreSQL, т.к. filesystem read-only):
# Создайте базу в Vercel Postgres / Neon (https://neon.tech) и вставьте URL.
# После смены DATABASE_URL на postgresql:// поменяйте provider в
# prisma/schema.prisma с "sqlite" на "postgresql" и запустите `bun run db:push`.
#
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
